<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#F3F0FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Couverture -->
        <ImageView
            android:id="@+id/mon_logoo"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:layout_marginEnd="16dp"
            android:scaleType="centerCrop" />

        <!-- Infos texte (prend tout l'espace restant) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitreLivre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Titre du livre"
                android:textColor="#1A0533"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAuteurLivre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Auteur"
                android:textColor="#6C3FC5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvIsbnLivre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ISBN"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <!--
                CORRECTION bug 4 : une seule déclaration de tvAnneeLivre.
                L'ancien fichier avait cet ID deux fois, ce qui causait
                un comportement indéfini (l'adapter ne trouvait jamais la bonne vue).
            -->
            <TextView
                android:id="@+id/tvAnneeLivre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#666666"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDisponibilite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/badge_arrondi"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Disponible"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Icônes modifier / supprimer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnModifierItem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Modifier"
                android:src="@android:drawable/ic_menu_edit" />

            <ImageButton
                android:id="@+id/btnSupprimerItem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Supprimer"
                android:src="@android:drawable/ic_menu_delete" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>